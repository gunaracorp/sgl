# =============================================================
# Samara Green Laundry — Konfigurasi Apache untuk Shared Hosting
# File ini ikut otomatis ke folder `out/` saat `next build`,
# lalu ter-upload bersama file lain ke public_html.
# =============================================================

# --- Halaman 404 (Next.js membuat 404.html saat export) ---
ErrorDocument 404 /404.html

# --- Kompresi Gzip: website lebih cepat, hemat bandwidth ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Browser Caching: pengunjung balik lagi, loading instan ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Charset default ---
AddDefaultCharset UTF-8

# --- Canonical Redirect SEO: www.sgl.web.id → sgl.web.id ---
# Mencegah duplikat konten di mata Google (www vs non-www dianggap 2 website).
# Aman: bekerja dengan baik baik saat HTTPS sudah aktif maupun belum.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.sgl\.web\.id$ [NC]
  RewriteCond %{HTTPS}s ^on(s)|off
  RewriteRule ^(.*)$ http%1://sgl.web.id/$1 [R=301,L]
</IfModule>

# --- Opsional: paksa HTTPS (hapus tanda # di 2 baris bawah jika
#     hosting Anda sudah punya SSL/https — jalankan AutoSSL dulu di cPanel) ---
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
